# 默认使用内置演示数据，无需配置即可运行
VITE_USE_REAL_AGENT=true
# Required only for the user-triggered OSM nearby-reference check. Use a stable,
# contactable app identifier in production; public Nominatim is rate-limited.
NOMINATIM_USER_AGENT=SomewhereTravelAgent/0.1 (+https://your-domain.example/contact)
# Optional but recommended whenever public OSRM/Nominatim traffic can run on
# more than one serverless instance. Used only by the server-side BFF.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional production routing provider/self-hosted OSRM endpoint. Omit only for
# low-volume development demo traffic through the public OSRM service.
OSRM_URL=https://your-osrm-or-routing-provider.example

# Vite 开发代理优先读取此变量；仅未配置时才兼容回退根目录 key.md 的 tokenhub: 值。
# 不要把 token 写入 VITE_ 变量或前端源码，也不要提交真实密钥。
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com
TOKENHUB_MODEL=hy3

# 仅用于已获得用户明确授权、且用户再次点击分析的单张图片理解。
# 图片默认只在本地预览；服务端仅返回受限标签，不保留图片或文件名。音频不分析。
# 当前账号的最小真实视觉请求出现上游拒绝/超时，部署前必须以目标账号、目标模型和区域验证稳定性。
TOKENHUB_MEDIA_MODEL=youtu-vita

# 地图默认使用 OpenStreetMap 在线底图，无需地图 Key。
# 当前道路路线核验使用 OSRM 公共演示端点，仅用于开发/公开演示，不配置 Key，不能作为生产服务。
# 生产请部署 BFF 并接入签约地图服务或自托管 OSRM；使用公共 OSRM/Nominatim 时请配置 Upstash 共享限流。Nominatim 仅提供低量、按需探索，审核 POI 数据层尚未接入。
